{
  "manifest_version": 3,
  "name": "Marketplace Filler (EpicNPC + G2G + Epic Signup)",
  "version": "1.5.0",
  "description": "Marketplace form tools and Epic signup using the local Outlook pool, with an optional residential proxy in a dedicated private window.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Marketplace Filler",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://www.epicnpc.com/*",
    "https://epicnpc.com/*",
    "https://www.g2g.com/*",
    "https://g2g.com/*",
    "https://www.epicgames.com/*",
    "https://epicgames.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.epicnpc.com/*",
        "https://epicnpc.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.g2g.com/*",
        "https://g2g.com/*"
      ],
      "js": [
        "g2g.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.epicgames.com/*",
        "https://epicgames.com/*",
        "https://store.epicgames.com/*",
        "https://accounts.epicgames.com/*"
      ],
      "js": [
        "epic-signup.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "nodeserver-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "incognito": "spanning"
}
