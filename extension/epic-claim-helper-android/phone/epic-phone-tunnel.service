[Unit]
Description=Epic phone claim bridge tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -i /root/.ssh/id_bothost -p 18022 -N -L 127.0.0.1:18125:127.0.0.1:8123 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ConnectTimeout=10 u0@127.0.0.1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
