{
  "manifest_version": 3,
  "name": "Epic Claim Helper",
  "version": "1.1.0",
  "description": "Claims free Epic games through your normal browser. Paired locally; pauses on visible security checks.",
  "background": {
    "service_worker": "epic-claim-background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "browsingData"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.epicgames.com/*",
    "https://epicgames.com/*",
    "https://store.epicgames.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://store.epicgames.com/purchase*"
      ],
      "js": [
        "epic-claim-network.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "epic-claim-connect.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.epicgames.com/*",
        "https://epicgames.com/*",
        "https://store.epicgames.com/*"
      ],
      "js": [
        "epic-claim-checkout.js",
        "epic-claim-recover.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
