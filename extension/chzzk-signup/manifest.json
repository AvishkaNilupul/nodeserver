{
  "manifest_version":3,"name":"CHZZK Signup — Local 5sim","version":"0.1.0",
  "description":"Naver signup with encrypted local storage, 5sim SMS and CHZZK farm handoff.",
  "incognito":"spanning","permissions":["storage","tabs","cookies"],
  "host_permissions":["http://127.0.0.1/*","https://*.naver.com/*"],
  "background":{"service_worker":"background.js"},
  "action":{"default_title":"Open CHZZK generator"},
  "content_scripts":[
    {"matches":["http://127.0.0.1/*"],"js":["bridge.js"],"run_at":"document_idle"},
    {"matches":["https://nid.naver.com/*","https://www.naver.com/*","https://chzzk.naver.com/*"],"js":["content.js"],"run_at":"document_idle"}
  ]
}
