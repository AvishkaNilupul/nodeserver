+  await FarmLane.deleteMany({ gameKey: "unclassified lane" });
+  const lane = await FarmLane.create({
+    game: "Unclassified Lane",
+    gameKey: "unclassified lane",
+    mode: "shadow",
+  });
+  await FarmJob.create({
+    lane: "Unclassified Lane",
+    laneKey: "unclassified lane",
+    kind: "decide",
