+  assert.equal(summary.decisions[0].decision, "skip_low_demand");
+  assert.equal(summary.skipsRecorded, 0);
+  assert.equal(await AutoFarmTask.countDocuments({ game }), 0, "no row: shadow changes nothing");
+});
