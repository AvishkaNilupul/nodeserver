+  const decidedAt = hoursAgo(30);
+  await MarketResearchSnapshot.create({
+    game,
+    gameKey: game.toLowerCase(),
+    at: new Date(decidedAt.getTime() - 3600000),
+    demandScore: 90,
+    sellers: 5,
+  });
+  const task = {
+    game,
+    campaignId: "st1",
+    decision: "reuse_existing",
+    demandScore: 90,
+    hadResearch: true,
+    internalSales: 0,
