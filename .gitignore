orderIds.json
messages.json
items.json
inventory.json

# Uploaded chat images
public/uploads

# ---- Server-side clutter from manual zip deploys (keep git status clean) ----

# Deploy snapshots (dirs AND stray files like _deploy_backup_marketplaces_*.js)
_deploy_backup_*

# Ad-hoc backups & one-off diagnostic/temp scripts (never part of the app)
_bk_*
_cred_backfill_backup_*
*_TEMP.js
*.bak
*.bak-*
*.bak_*
server.js.bak*

# macOS AppleDouble metadata files (._something)
._*
.DS_Store

# Python bytecode cache from the marketplace service
__pycache__/
*.pyc

# Runtime-generated assets & local host/settings config (live-only, not in git)
public/drop-images/
config/botHosts.json
config/botHosts.json.bak*
utils/settings.json
.env.bak*

# Ad-hoc watch/diagnostic scratch scripts written straight onto the server
_TEMP_*

# Top-level Python virtualenv (marketplace service is run from here on prod)
/.venv

# ---- Seller Android app (android/) ----
# The APK SIGNING KEY and its plaintext password must never reach GitHub: a
# pushed key stays in history forever and lets anyone with repo access sign
# releases as us. The rest here is generated build output (~49MB). Listed by
# path rather than ignoring android/ wholesale, so real project source added
# later is still tracked.
android/keystore/
android/local.properties
android/.gradle/
android/build/
android/app/build/
# The new-project-wizard default location for the same secrets
android/key.properties
*.jks
*.keystore
