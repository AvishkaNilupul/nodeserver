{
  "manifest_version": 3,
  "name": "Stream Companion Fourth",
  "version": "0.12.0",
  "description": "A separate personal Stream Companion with its own local helper and account.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8797/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Stream Companion Fourth"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://www.twitch.tv/*"
  ]
}
